# dependencies
node_modules/
.pnpm-store/

# build output
dist/
dist-ssr/
*.tsbuildinfo

# The Wails shell's output and generated bindings. build/ itself is tracked —
# it holds the packaging files and the committed icons (see #44) — and only
# the binary output directory inside it is not. wailsjs/ is the runtime the
# wails CLI generates into the frontend dir; nothing imports it, because the
# JS↔Go surface is the HTTP API, not bindings.
build/bin/
wailsjs/

# Generated by `wails build` on Windows, and deliberately not committed.
# packageApplicationForWindows() writes build/windows/icon.ico from
# build/appicon.png *only when it is missing*, so a committed one is never
# refreshed and a stale icon ships forever and silently - the trap Konnekt's
# build/README.md names and scripts/gen-appicon cites. The .syso carries the
# compiled version resource into the link and is normally deleted after the
# build; it survives a failed one.
build/windows/icon.ico
*.syso

# test / coverage
coverage/
.vitest/

# aislop appends a scan record here on every run; it is local state, not policy.
.aislop/history.jsonl

# caches
# Python bytecode, from running the vendored release-notes test.
__pycache__/
.cache/
# ^ includes .cache/mcmeta/<tag>/, where the deriver keeps the fetched summaries.
# The tag is pinned and immutable, so the cache never goes stale — it exists so a
# warm run needs no network and an mcmeta outage cannot redden CI on an unrelated
# change. CI restores it with actions/cache keyed on the tag.
.temp/
.vite/
.eslintcache

# env — never commit; also denied to Claude in .claude/settings.json
.env
.env.*
!.env.example
secrets/

# editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.swp

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# NOTE: src/data/generated/ is intentionally NOT ignored, and neither are
# tokens.source.json or src/styles/tokens.css.
# Generated command skeletons and registries are committed so that version
# bumps produce reviewable diffs and builds work offline. The token source is
# vendored from kollektiv for the same reason: a build must work from a
# standalone clone, without a kollektiv checkout beside it.
# See docs/architecture.md § Derivation.

# Agent tooling: shared config is committed so every clone and cloud agent
# inherits the same setup. Personal state is not.
.claude/settings.local.json
