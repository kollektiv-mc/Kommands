Name:           kommands
Version:        %{_version}
Release:        1%{?dist}
Summary:        Minecraft command generator
License:        MIT
URL:            https://github.com/kollektiv-mc/Kommands

Source0:        kommands-linux-amd64
Source1:        kommands.desktop
# The 256px icon rather than build/appicon.png: /usr/share/pixmaps entries are
# drawn at 48px or smaller, and the 1024px source would make every launcher
# decode a far larger image to do it. Generated by `go run ./scripts/gen-appicon`.
Source2:        appicon-256.png

BuildArch:      x86_64

# Source0 is a prebuilt binary (built against webkit2gtk-4.1 in a separate CI
# job), not sources rpmbuild compiles - auto dependency scanning would pick up
# sonames from the build container instead of the packaging container, so
# runtime deps are declared by hand instead.
AutoReqProv:    no
Requires:       webkit2gtk4.1
Requires:       gtk3

%description
Kommands builds Minecraft Java Edition commands from a guided editor rather
than from memory, and generates syntax for the version you target. It runs
offline, with the command data for that version bundled in the binary.

This package is also what registers the kommands:// URL scheme, by installing
the desktop entry that declares the handler. A bare binary does not.

%prep
# nothing to unpack - Source0 is a prebuilt binary

%build
# nothing to build - Source0 is a prebuilt binary

%install
install -Dm755 %{SOURCE0} %{buildroot}%{_bindir}/kommands
install -Dm644 %{SOURCE1} %{buildroot}%{_datadir}/applications/kommands.desktop
install -Dm644 %{SOURCE2} %{buildroot}%{_datadir}/pixmaps/kommands.png

%files
%{_bindir}/kommands
%{_datadir}/applications/kommands.desktop
%{_datadir}/pixmaps/kommands.png

%changelog
